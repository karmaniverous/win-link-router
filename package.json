{
  "author": "Jason Williscroft",
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "unreleased": true,
    "commitLimit": false,
    "hideCredit": true
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/win-link-router/issues"
  },
  "dependencies": {
    "@mantine/core": "^8.3.12",
    "@mantine/hooks": "^8.3.12",
    "@tabler/icons-react": "^3.36.1",
    "@vitejs/plugin-react": "^5.1.2",
    "electron-squirrel-startup": "^1.0.1",
    "handlebars": "^4.7.8",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-github-btn": "^1.4.0",
    "zod": "^4.3.5"
  },
  "description": "My Electron application description",
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.4",
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron-forge/shared-types": "^7.11.1",
    "@electron/fuses": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitest/eslint-plugin": "^1.6.6",
    "auto-changelog": "^2.5.0",
    "electron": "39.2.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.0.0",
    "jsdom": "^27.4.0",
    "knip": "^5.80.2",
    "lefthook": "^2.0.15",
    "prettier": "^3.7.4",
    "release-it": "^19.2.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/karmaniverous/win-link-router#readme",
  "keywords": [],
  "license": "BSD-3-Clause",
  "main": ".vite/build/main.js",
  "name": "@karmaniverous/win-link-router",
  "productName": "win-link-router",
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --stdout --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "commitMessage": "chore: release v${version}",
      "requireBranch": "main",
      "tagName": "v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "v${version}",
      "assets": [
        "out/make/**/RELEASES",
        "out/make/**/*.nupkg",
        "out/make/**/*.exe"
      ]
    },
    "hooks": {
      "after:init": [
        "npm run typecheck",
        "npm run lint",
        "npm run test"
      ],
      "before:github:release": [
        "npm run make"
      ],
      "after:release": [
        "git switch -c release/${version}",
        "git push -u origin release/${version}",
        "git switch ${branchName}"
      ]
    },
    "npm": {
      "publish": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/karmaniverous/win-link-router"
  },
  "scripts": {
    "changelog": "auto-changelog",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix .",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.prerelease --preRelease",
    "start": "electron-forge start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "version": "0.1.2"
}
